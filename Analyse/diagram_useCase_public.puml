@startuml
left to right direction

actor Auteur

rectangle "Fonctionnalités du Blog" {

  usecase "Consulter la page d'accueil" as UC1
  usecase "Voir les articles" as UC2
  usecase "Voir détails d'un article" as UC3
  usecase "Filtrer par catégorie" as UC4
  usecase "Rechercher un article" as UC5

  usecase "Liker un article" as UC6
  usecase "Ajouter/Supprimer un commentaire" as UC7
  usecase "Partager un article" as UC8
  usecase "Gérer favoris" as UC9

  usecase "Voir/Éditer profil" as UC10
  usecase "Créer un article" as UC11
  usecase "Se déconnecter" as UC12
}

rectangle "Authentification" {
  usecase "Se connecter" as LOGIN
}

