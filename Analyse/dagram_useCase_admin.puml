@startuml
left to right direction

'============== Acteurs ==============
actor Auteur as E
actor Admin as A

'============== Cas d'utilisation (centre) ==============
rectangle "Fonctionnalités" {

  ' --- Auteur ---
  usecase "Voir article" as E1
  usecase "Rechercher/Filtrer un article" as E2
  usecase "Gérer article\n(ajout/edition/suppression)" as E3
  usecase "Envoyer article pour validation" as E4

  ' --- Anciennes fonctionnalités du Modérateur (passées à Admin) ---
  usecase "Valider articles" as M1
  usecase "Voir/Supprimer commentaires" as M2

  ' --- Admin ---
  usecase "Voir dashboard admin" as A1
  usecase "Voir/Supprimer utilisateurs" as A2
  usecase "Gérer catégories\n(ajout/mod/suppression)" as A3
  usecase "Voir/Supprimer articles" as A4
}

'============== Authentification ==============
rectangle "Authentification" {
  usecase "Se connecter" as LOGIN
}

'============== Associations ==============

' Auteur
E -- E1
E -- E2
E -- E3
E -- E4

' Admin (avec les fonctionnalités du Modérateur)
A -- A1
A -- A2
A -- A3
A -- A4
A -- M1
A -- M2

'============== Relations include ==============
E1 --> LOGIN : <<include>>
E2 --> LOGIN : <<include>>
E3 --> LOGIN : <<include>>
E4 --> LOGIN : <<include>>

M1 --> LOGIN : <<include>>
M2 --> LOGIN : <<include>>

A1 --> LOGIN : <<include>>
A2 --> LOGIN : <<include>>
A3 --> LOGIN : <<include>>
A4 --> LOGIN : <<include>>

@enduml
